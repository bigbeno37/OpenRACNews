---
import DayDigest from '../components/DayDigest.astro';
import Hero from '../components/Hero.astro';
import Row from '../components/Row.astro';
import Section from '../components/Section.astro';
import Layout from '../layouts/Layout.astro';
import { formatDayShort } from '../lib/days.ts';
import { count } from '../lib/format.ts';
import { dayUrl, url } from '../lib/links.ts';
import { dayFacts, loadDays } from '../lib/news.ts';

const days = await loadDays();
const [latest, ...earlier] = days;
---

<Layout current="latest">
  {
    latest ? (
      <>
        <DayDigest day={latest} />
        {earlier.length > 0 && (
          <Section id="earlier" art="activity" title="Earlier days" sub="The days before this one, newest first.">
            <ul class="grid grid-cols-[minmax(0,1fr)] gap-2.5">
              {earlier.slice(0, 7).map((day) => (
                <Row href={dayUrl(day.date)} title={day.overview?.headline ?? dayFacts(day)}>
                  <span slot="lead" class="flex-none font-orbitron text-[13px] font-semibold text-gold">{formatDayShort(day.date)}</span>
                  <span>{count(day.totals.commits, 'commit')}</span>
                </Row>
              ))}
            </ul>
            {earlier.length > 7 && <a href={url('/days/')} class="btn btn-sm mt-5">Browse every day</a>}
          </Section>
        )}
      </>
    ) : (
      <Hero eyebrow="Daily digest">
        <Fragment slot="shine">No days</Fragment>
        <Fragment slot="title">on record yet.</Fragment>
        <p class="mt-5 max-w-[600px] text-soft">The first digest appears after the next daily snapshot. To create one now, run <code class="text-gold">pnpm snapshot</code>.</p>
      </Hero>
    )
  }
</Layout>
