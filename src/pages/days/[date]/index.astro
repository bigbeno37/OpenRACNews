---
import DaySnapshot from '../../../components/DaySnapshot.astro';
import Layout from '../../../layouts/Layout.astro';
import { formatDay } from '../../../lib/days.ts';
import { dayOn, dayRange } from '../../../lib/news.ts';

export async function getStaticPaths() {
  return (await dayRange()).map((date) => ({ params: { date } }));
}

const { date } = Astro.params;
const day = await dayOn(date);
---

<Layout title={formatDay(date)} description={day.overview?.headline} date={date}>
  <DaySnapshot date={date} />
</Layout>
