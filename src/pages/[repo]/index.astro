---
// A project's own page, the heart of the site: its latest report for each tracked branch, its earlier
// days, and its issues and releases, in that game's colours.
import Badge from '../../components/Badge.astro';
import DayBar from '../../components/DayBar.astro';
import Hero from '../../components/Hero.astro';
import Icons from '../../components/Icons.astro';
import ReportCard from '../../components/ReportCard.astro';
import Row from '../../components/Row.astro';
import Section from '../../components/Section.astro';
import Layout from '../../layouts/Layout.astro';
import { formatDayMonthShort, formatDayShort } from '../../lib/days.ts';
import { count, formatNumber } from '../../lib/format.ts';
import { reportUrl } from '../../lib/links.ts';
import { branchFacts, eventRows, highlightsFrom, loadProjects, RECENT_DAYS, type Project } from '../../lib/news.ts';
import { barStyle, themeFor } from '../../lib/themes.ts';
import { branchSlug, repoUrl } from '../../lib/tracking.ts';

export async function getStaticPaths() {
  const projects = await loadProjects();
  return projects.map((project) => ({ params: { repo: project.repo.name }, props: { project } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { repo, branches, recent, activity, lastActive } = project;
const theme = themeFor(repo.name);

const stats: [string, string][] = [
  [formatNumber(recent.commits), `${recent.commits === 1 ? 'commit' : 'commits'} in ${RECENT_DAYS} days`],
  [formatNumber(recent.merged), `${recent.merged === 1 ? 'pull request' : 'pull requests'} merged`],
  [formatNumber(recent.contributors), recent.contributors === 1 ? 'contributor' : 'contributors'],
  [lastActive ? formatDayMonthShort(lastActive) : 'Not yet', 'last active'],
];

const VISIBLE_ROWS = 10;
const rows = project.events.flatMap(eventRows);
---

<Layout title={repo.title} description={repo.about} repo={repo.name}>
  <Hero eyebrow={repo.name} font={theme.font}>
    <Fragment slot="shine">{repo.title}</Fragment>
    <p class="mt-5 max-w-[600px] text-[15px] leading-relaxed text-soft sm:text-[17px]">{repo.about}</p>
    <div class="mt-7 grid animate-rise gap-3 [animation-delay:.45s] min-[560px]:flex min-[560px]:flex-wrap">
      <a href={repoUrl(repo.name)} class="btn btn-primary"><Icons name="github" class="size-4" />See it on GitHub</a>
      {branches.length > 1 && branches.map(({ branch }) => <a href={`#${branchSlug(branch.name)}`} class="btn">{branch.name}</a>)}
    </div>

    <div class="mt-10 grid max-w-[900px] animate-rise grid-cols-2 gap-2.5 [animation-delay:.6s] min-[560px]:grid-cols-4 sm:mt-12 sm:gap-3.5">
      {
        stats.map(([value, label]) => (
          <div class="surface px-3 py-3 sm:px-[18px] sm:py-4">
            <b class="block whitespace-nowrap font-orbitron text-[clamp(15px,4.2vw,26px)] font-bold leading-tight tabular-nums text-gold">{value}</b>
            <span class="mt-0.5 block text-[12px] leading-snug text-dim sm:text-[13px]">{label}</span>
          </div>
        ))
      }
    </div>
    <div class="mt-6 max-w-[900px]" style={barStyle(repo.name)}>
      <DayBar activity={activity} />
    </div>
  </Hero>

  {
    branches.map(({ branch, days }) => {
      const [latest, ...earlier] = days;
      const shown = earlier.slice(0, VISIBLE_ROWS);
      const older = earlier.slice(VISIBLE_ROWS);
      const row = (day: (typeof days)[number]) => (
        <Row href={reportUrl(repo.name, branch.name, day.date)} title={day.report?.headline ?? highlightsFrom(repo.name, day.facts, 1)[0]?.title ?? branchFacts(day.facts)}>
          <span slot="lead" class="flex-none font-orbitron text-[13px] font-semibold text-gold">{formatDayShort(day.date)}</span>
          <span>{day.facts.totals.commits > 0 ? count(day.facts.totals.commits, 'commit') : branchFacts(day.facts)}</span>
        </Row>
      );
      return (
        <Section id={branchSlug(branch.name)} art="activity" title={`Latest on ${branch.name}`} sub={branch.about}>
          {latest ? <ReportCard day={latest} heading="date" /> : <p class="text-dim">Nothing on record for this branch yet. It will appear here the first day something lands on it.</p>}
          {shown.length > 0 && (
            <>
              <h3 class="mb-3 mt-8 font-orbitron text-[12px] font-bold uppercase tracking-[.2em] text-hi">Earlier on {branch.name}</h3>
              <ul class="grid grid-cols-[minmax(0,1fr)] gap-2.5">{shown.map(row)}</ul>
            </>
          )}
          {older.length > 0 && (
            <details class="surface mt-3">
              <summary class="flex cursor-pointer items-center gap-3 px-5 py-4 font-orbitron text-[15px] font-bold text-gold sm:px-6">
                <span aria-hidden="true" class="plus text-xl leading-none text-brand transition-transform">+</span>
                {count(older.length, 'older day')}
              </summary>
              <ul class="grid grid-cols-[minmax(0,1fr)] gap-2.5 px-5 pb-5 sm:px-6">{older.map(row)}</ul>
            </details>
          )}
        </Section>
      );
    })
  }

  {
    rows.length > 0 && (
      <Section id="repo-wide" art="fresh" title="Issues and releases" sub="These belong to the repository as a whole rather than to one of its branches. Newest first.">
        <ul class="grid grid-cols-[minmax(0,1fr)] gap-2.5">
          {rows.slice(0, VISIBLE_ROWS).map((item) => (
            <Row href={item.href} title={item.title}>
              <Fragment slot="lead">
                <span class="flex-none font-orbitron text-[13px] font-semibold text-gold">{formatDayShort(item.date)}</span>
                <Badge>{item.badge}</Badge>
              </Fragment>
              <span>{item.note}</span>
            </Row>
          ))}
        </ul>
        {rows.length > VISIBLE_ROWS && (
          <details class="surface mt-3">
            <summary class="flex cursor-pointer items-center gap-3 px-5 py-4 font-orbitron text-[15px] font-bold text-gold sm:px-6">
              <span aria-hidden="true" class="plus text-xl leading-none text-brand transition-transform">+</span>
              {formatNumber(rows.length - VISIBLE_ROWS)} more
            </summary>
            <ul class="grid grid-cols-[minmax(0,1fr)] gap-2.5 px-5 pb-5 sm:px-6">
              {rows.slice(VISIBLE_ROWS).map((item) => (
                <Row href={item.href} title={item.title}>
                  <Fragment slot="lead">
                    <span class="flex-none font-orbitron text-[13px] font-semibold text-gold">{formatDayShort(item.date)}</span>
                    <Badge>{item.badge}</Badge>
                  </Fragment>
                  <span>{item.note}</span>
                </Row>
              ))}
            </ul>
          </details>
        )}
      </Section>
    )
  }
</Layout>
