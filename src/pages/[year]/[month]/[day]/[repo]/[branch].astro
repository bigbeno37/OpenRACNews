---
// Everything one branch did on one day: its report, then every pull request and commit.
import Badge from '../../../../../components/Badge.astro';
import Hero from '../../../../../components/Hero.astro';
import ReportCard from '../../../../../components/ReportCard.astro';
import Row from '../../../../../components/Row.astro';
import Section from '../../../../../components/Section.astro';
import Layout from '../../../../../layouts/Layout.astro';
import { dayParams, formatDay, formatDayShort } from '../../../../../lib/days.ts';
import { count, formatNumber, sentenceList, timeOf } from '../../../../../lib/format.ts';
import { commitUrl, dayUrl, projectUrl, pullUrl } from '../../../../../lib/links.ts';
import { viewableDays, type BranchDay } from '../../../../../lib/news.ts';
import type { Commit } from '../../../../../lib/schema.ts';
import { themeFor } from '../../../../../lib/themes.ts';
import { branchSlug } from '../../../../../lib/tracking.ts';

export async function getStaticPaths() {
  const days = await viewableDays();
  return days.flatMap((day) =>
    day.branches.map((branchDay) => ({
      params: { ...dayParams(branchDay.date), repo: branchDay.repo.name, branch: branchSlug(branchDay.branch.name) },
      props: { day: branchDay },
    })),
  );
}

interface Props {
  day: BranchDay;
}
const { day } = Astro.props;
const { repo, branch, date, facts, report } = day;
const theme = themeFor(repo.name);

const landed = facts.commits.filter((c) => c.landed).reverse();
const mergedIn = facts.commits.filter((c) => !c.landed).reverse();
const forcePushes = facts.pushes.filter((p) => p.type === 'force_push');
const short = (commit: Commit) => commit.sha.slice(0, 7);
---

<Layout title={`${repo.title} ${branch.name}, ${formatDayShort(date)}`} description={report?.headline} date={date} repo={repo.name}>
  <Hero eyebrow={`Branch report · ${formatDay(date)}`} font={theme.font} compact>
    <Fragment slot="shine">{repo.title}</Fragment>
    <Fragment slot="title">{branch.name}</Fragment>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href={projectUrl(date, repo.name)} class="btn btn-sm">Back to {theme.tag} on {formatDayShort(date)}</a>
      <a href={dayUrl(date)} class="btn btn-sm">All projects on {formatDayShort(date)}</a>
    </div>
  </Hero>

  <div class="pt-6">
    <ReportCard day={day} link={false} />
  </div>

  {
    (facts.warnings.length > 0 || forcePushes.length > 0) && (
      <div class="mt-5 rounded-xl border-l-4 border-brand bg-brand/10 px-4 py-3.5 text-soft">
        {forcePushes.length > 0 && <p>History on this branch was rewritten {count(forcePushes.length, 'time')} on this day, at {sentenceList(forcePushes.map((p) => `${timeOf(p.at)} UTC by ${p.actor ?? 'an unknown account'}`))}.</p>}
        {facts.warnings.map((warning) => <p>{warning}</p>)}
      </div>
    )
  }

  {
    facts.pullRequests.length > 0 && (
      <Section id="pull-requests" art="fresh" title={count(facts.pullRequests.length, 'pull request')} sub={`Opened, merged or closed against ${branch.name} on this day.`}>
        <ul class="grid grid-cols-[minmax(0,1fr)] gap-2.5">
          {facts.pullRequests.map((pr) => (
            <Row href={pullUrl(repo.name, pr.number)} title={pr.title}>
              <Fragment slot="lead">
                {pr.events.map((event) => <Badge>{event}</Badge>)}
                {pr.draft && <Badge>draft</Badge>}
              </Fragment>
              <span>#{pr.number}</span>
              <span>{pr.author}</span>
              <span>+{formatNumber(pr.additions)} −{formatNumber(pr.deletions)}</span>
            </Row>
          ))}
        </ul>
      </Section>
    )
  }

  {
    facts.commits.length > 0 && (
      <Section id="commits" art="activity" title={count(facts.totals.commits, 'commit')} sub={mergedIn.length > 0 ? `${count(landed.length, 'commit')} landed directly on ${branch.name}, newest first. The rest came in through merges and are listed at the end. Line counts cover what landed, so merged work isn't counted twice.` : `What landed on ${branch.name}, newest first.`}>
        <ul class="grid grid-cols-[minmax(0,1fr)] gap-2.5">
          {landed.map((commit) => (
            <Row href={commitUrl(repo.name, commit.sha)} title={commit.headline}>
              <code slot="lead" class="flex-none text-[13px] text-amber">{short(commit)}</code>
              <span>{commit.author}</span>
              <span>+{formatNumber(commit.additions ?? 0)} −{formatNumber(commit.deletions ?? 0)}</span>
            </Row>
          ))}
        </ul>
        {mergedIn.length > 0 && (
          <details class="surface mt-5">
            <summary class="flex cursor-pointer items-center gap-3 px-5 py-4 font-orbitron text-[15px] font-bold text-gold sm:px-6">
              <span aria-hidden="true" class="plus text-xl leading-none text-brand transition-transform">+</span>
              {count(mergedIn.length, 'commit')} brought in by merges
            </summary>
            <ul class="grid grid-cols-[minmax(0,1fr)] gap-2.5 px-5 pb-5 sm:px-6">
              {mergedIn.map((commit) => (
                <Row href={commitUrl(repo.name, commit.sha)} title={commit.headline}>
                  <code slot="lead" class="flex-none text-[13px] text-amber">{short(commit)}</code>
                  <span>{commit.author}</span>
                </Row>
              ))}
            </ul>
          </details>
        )}
      </Section>
    )
  }
</Layout>
