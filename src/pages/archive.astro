---
import Hero from '../components/Hero.astro';
import Row from '../components/Row.astro';
import Section from '../components/Section.astro';
import Layout from '../layouts/Layout.astro';
import { formatDay } from '../lib/days.ts';
import { count } from '../lib/format.ts';
import { dayUrl } from '../lib/links.ts';
import { dayFacts, viewableDays } from '../lib/news.ts';

const days = await viewableDays();
---

<Layout title="Every day" description="Every day the OpenRAC projects got a written report, newest first.">
  <Hero eyebrow="Archive" compact>
    <Fragment slot="shine">Every day</Fragment>
    <Fragment slot="title">on record.</Fragment>
    <p class="mt-5 max-w-[600px] text-soft">Days with no written report don't appear here.</p>
  </Hero>
  <Section id="days" art="all" title={count(days.length, 'day')}>
    <ul class="mt-6 grid grid-cols-[minmax(0,1fr)] gap-2.5">
      {
        days.map((day) => (
          <Row href={dayUrl(day.date)} title={day.overview?.headline ?? dayFacts(day)}>
            <span slot="lead" class="flex-none font-orbitron text-[13px] font-semibold text-gold">{formatDay(day.date)}</span>
            <span>{count(day.totals.merged, 'pull request')} merged</span>
          </Row>
        ))
      }
    </ul>
  </Section>
</Layout>
