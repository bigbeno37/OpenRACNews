<canvas data-embers aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[640px] w-full"></canvas>

<script>
  // Slowly rising embers behind the hero, as on openrac.dev (src/components/ui/Particles.tsx). The one
  // script on the site, and purely decorative: off for reduced motion, and drawn only while the hero is
  // on screen and the tab is visible. Everything else works without it.
  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-embers]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let w = 0;
    let h = 0;
    let raf = 0;
    let visible = false;
    let dots: { x: number; y: number; r: number; v: number; a: number }[] = [];

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.offsetWidth;
      h = canvas.offsetHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = getComputedStyle(canvas).getPropertyValue('--color-amber') || '#f5c040';
      dots = Array.from({ length: Math.min(46, Math.floor(w / 24)) }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.8 + 0.6,
        v: Math.random() * 0.25 + 0.08,
        a: Math.random() * 0.5 + 0.2,
      }));
    };
    const loop = () => {
      ctx.clearRect(0, 0, w, h);
      for (const d of dots) {
        d.y -= d.v;
        d.x += Math.sin(d.y / 60) * 0.15;
        if (d.y < -4) {
          d.y = h + 4;
          d.x = Math.random() * w;
        }
        ctx.globalAlpha = d.a;
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.r, 0, 7);
        ctx.fill();
      }
      raf = requestAnimationFrame(loop);
    };
    const update = () => {
      cancelAnimationFrame(raf);
      if (visible && !document.hidden) raf = requestAnimationFrame(loop);
    };
    // Only the width matters: mobile browsers resize the window as their toolbars slide.
    let lastWidth = window.innerWidth;
    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth !== lastWidth) {
          lastWidth = window.innerWidth;
          resize();
        }
      },
      { passive: true },
    );
    document.addEventListener('visibilitychange', update);
    resize();
    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false;
      update();
    }).observe(canvas);
  }
</script>
