---
// One branch on one day, built like the game cards on openrac.dev: the game's colours behind a dark
// wash, its name and headline number on top, a thin bar, and the repository along the bottom.
import { formatNumber, count } from '../lib/format.ts';
import { reportUrl, treeUrl } from '../lib/links.ts';
import { branchFacts, type BranchDay } from '../lib/news.ts';
import { themeFor } from '../lib/themes.ts';
import { tracking } from '../lib/tracking.ts';
import HourBar from './HourBar.astro';
import Icons from './Icons.astro';
import Prose from './Prose.astro';

interface Props {
  day: BranchDay;
  /** Links to the full report. Off on that report's own page. */
  link?: boolean;
}
const { day, link = true } = Astro.props;
const { repo, branch, date, facts, report } = day;
const theme = themeFor(repo.name);
const { commits, additions, deletions, authors } = facts.totals;
const style = `--tx: ${theme.text}; background-image: linear-gradient(120deg, ${theme.from}, ${theme.to});`;
---

<article id={`${repo.name}-${branch.name}`} class="group/card relative isolate scroll-mt-16 overflow-hidden rounded-2xl bg-ink" style={style}>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/95 via-ink/85 to-ink/70"></div>

  <div class="grid gap-4 p-5 sm:p-6">
    <div class="flex items-end justify-between gap-4">
      <div class="min-w-0">
        <h3 class={`${theme.font} text-[clamp(20px,3.4vw,28px)] leading-tight text-hi`}>{repo.title}</h3>
        <p class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[13px] text-dim">
          <span>{repo.name}</span>
          <span class="rounded-full border border-white/15 px-2 py-0.5 text-[10px] uppercase tracking-[.15em] sm:text-[11px]">{branch.name}</span>
        </p>
      </div>
      <div class="grid flex-none justify-items-end text-right">
        <b class={`${theme.font} whitespace-nowrap text-[clamp(20px,3.4vw,28px)] leading-tight tabular-nums text-(--tx)`}>{formatNumber(commits)}</b>
        <p class="mt-1 whitespace-nowrap text-[13px] tabular-nums text-dim">
          {commits === 1 ? 'commit' : 'commits'}
          {
            additions + deletions > 0 && (
              <>
                , <span class="text-text">+{formatNumber(additions)}</span> <span class="text-text">−{formatNumber(deletions)}</span>
              </>
            )
          }
        </p>
      </div>
    </div>

    <HourBar pushes={facts.pushes} />

    {
      report ? (
        <div class="grid max-w-[820px] gap-3">
          <h4 class="font-orbitron text-[17px] font-bold leading-snug text-gold sm:text-[19px]">
            <Prose text={report.headline} repo={repo.name} inline />
          </h4>
          <div class="grid gap-3 text-soft">
            <Prose text={report.summary} repo={repo.name} />
          </div>
          {report.highlights.length > 0 && (
            <ul class="grid gap-1.5 text-body">
              {report.highlights.map((highlight) => (
                <li class="flex gap-2.5">
                  <i aria-hidden="true" class="mt-[.6em] size-1.5 flex-none rounded-full bg-(--tx)" />
                  <span class="min-w-0">
                    <Prose text={highlight} repo={repo.name} inline />
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ) : (
        <p class="max-w-[820px] text-soft">
          {branchFacts(facts)}. <span class="text-dim">The written report for this branch isn't ready yet.</span>
        </p>
      )
    }

    <div class="flex min-w-0 flex-wrap items-center gap-x-5 gap-y-2 text-[13px] text-dim">
      <a href={treeUrl(repo.name, branch.name)} class="inline-flex min-h-8 min-w-0 max-w-full items-center gap-2 text-text no-underline transition-colors hover:text-hi">
        <Icons name="github" class="size-[18px]" />
        <span class="truncate">{tracking.org}/{repo.name}</span>
      </a>
      {authors.length > 0 && <span>{count(authors.length, 'contributor')}</span>}
      {link && <a href={reportUrl(repo.name, branch.name, date)} class="btn btn-sm sm:ml-auto">{report ? 'Read the full report' : 'See commits and pull requests'}</a>}
    </div>
  </div>

  <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[inherit] border border-white/8 transition-colors duration-500 group-hover/card:border-white/20"></div>
</article>
