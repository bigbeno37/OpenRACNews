---
// A whole day: the overview and its numbers, every branch's report, then what belongs to a repo rather
// than a branch. The home page shows this for the latest day, and each day has a page of its own.
import { formatDay, formatDayMonth } from '../lib/days.ts';
import { formatNumber, sentenceList } from '../lib/format.ts';
import { issueUrl, releaseUrl } from '../lib/links.ts';
import { dayFacts, type Day } from '../lib/news.ts';
import { paragraphs } from '../lib/prose.ts';
import { trackedBranches } from '../lib/tracking.ts';
import Badge from './Badge.astro';
import Hero from './Hero.astro';
import Icons from './Icons.astro';
import Prose from './Prose.astro';
import ReportCard from './ReportCard.astro';
import Row from './Row.astro';
import Section from './Section.astro';
import Tag from './Tag.astro';
import { url } from '../lib/links.ts';

interface Props {
  day: Day;
}
const { day } = Astro.props;
const { overview, totals } = day;
const longDate = formatDay(day.date);

const stats: [number, string][] = [
  [totals.commits, totals.commits === 1 ? 'commit landed' : 'commits landed'],
  [totals.merged, totals.merged === 1 ? 'pull request merged' : 'pull requests merged'],
  [totals.opened, totals.opened === 1 ? 'pull request opened' : 'pull requests opened'],
  [totals.contributors, totals.contributors === 1 ? 'contributor' : 'contributors'],
];

// Tracked branches that did nothing today, so a missing report reads as quiet rather than forgotten.
const quiet = trackedBranches()
  .filter(({ repo, branch }) => !day.branches.some((b) => b.repo.name === repo.name && b.branch.name === branch.name))
  .map(({ repo, branch }) => `${repo.title} (${branch.name})`);

const closedWords: Record<string, string> = { COMPLETED: 'closed as completed', NOT_PLANNED: 'closed as not planned', DUPLICATE: 'closed as a duplicate' };
const issueWords = (events: string[], closedAs: string | null) =>
  sentenceList(events.map((event) => (event === 'closed' ? (closedAs && closedWords[closedAs]) || 'closed' : event)));

const repoRows = day.repos.flatMap(({ repo, facts }) => [
  ...facts.releases.map((release) => ({
    repo: repo.name,
    title: release.name || release.tag,
    href: releaseUrl(repo.name, release.tag),
    badge: release.prerelease ? 'prerelease' : 'release',
    note: release.tag,
  })),
  ...facts.issues.map((issue) => ({
    repo: repo.name,
    title: issue.title,
    href: issueUrl(repo.name, issue.number),
    badge: 'issue',
    note: `#${issue.number} ${issueWords(issue.events, issue.closedAs)}`,
  })),
]);
---

<Hero eyebrow={`Daily digest · ${longDate}`}>
  <Fragment slot="shine">{formatDayMonth(day.date)}:</Fragment>
  <Fragment slot="title">{overview ? <Prose text={overview.headline} inline /> : dayFacts(day)}</Fragment>

  <div class="mt-5 grid max-w-[680px] gap-3 text-[15px] leading-relaxed text-soft sm:text-[17px]">
    {overview ? paragraphs(overview.summary).map((paragraph) => <p><Prose text={paragraph} inline /></p>) : <p>The written summary for this day isn't ready yet. Everything that happened is listed below.</p>}
  </div>

  <div class="mt-7 grid animate-rise gap-3 [animation-delay:.45s] min-[560px]:flex min-[560px]:flex-wrap">
    <a href="#reports" class="btn btn-primary"><Icons name="down" class="size-4" />{day.branches.some((branch) => branch.report) ? 'Read the branch reports' : 'See each branch'}</a>
    <a href={url('/days/')} class="btn">Browse every day</a>
  </div>

  <div class="mt-10 grid max-w-[900px] animate-rise grid-cols-2 gap-2.5 [animation-delay:.6s] min-[560px]:grid-cols-4 sm:mt-12 sm:gap-3.5">
    {
      stats.map(([value, label]) => (
        <div class="surface px-3 py-3 sm:px-[18px] sm:py-4">
          <b class="block whitespace-nowrap font-orbitron text-[clamp(15px,4.2vw,26px)] font-bold leading-tight tabular-nums text-gold">{formatNumber(value)}</b>
          <span class="mt-0.5 block text-[12px] leading-snug text-dim sm:text-[13px]">{label}</span>
        </div>
      ))
    }
  </div>
</Hero>

<Section id="reports" art="progress" title="Branch reports" sub="What landed on each tracked branch during this UTC day. Each bar is the day from 00:00 to 23:59, one segment per hour, brighter the more pushes and merges landed.">
  {
    day.branches.length > 0 ? (
      <div class="grid gap-3 sm:gap-4">
        {day.branches.map((branch) => (
          <ReportCard day={branch} />
        ))}
      </div>
    ) : (
      <p class="text-dim">No tracked branch changed on this day.</p>
    )
  }
  {day.branches.length > 0 && quiet.length > 0 && <p class="mt-5 text-[13px] text-dim">Nothing landed on {sentenceList(quiet)} on this day.</p>}
</Section>

{
  repoRows.length > 0 && (
    <Section id="repo-wide" art="fresh" title="Issues and releases" sub="These belong to a repository as a whole rather than to one of its branches.">
      <ul class="grid grid-cols-[minmax(0,1fr)] gap-2.5">
        {repoRows.map((row) => (
          <Row href={row.href} title={row.title}>
            <Fragment slot="lead">
              <Tag repo={row.repo} />
              <Badge>{row.badge}</Badge>
            </Fragment>
            <span>{row.note}</span>
          </Row>
        ))}
      </ul>
    </Section>
  )
}
