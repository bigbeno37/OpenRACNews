---
// The small drawings beside each section's heading, from openrac.dev (src/components/ui/SectionArt.tsx):
// flat shapes with a dark outline over a spiky gold burst, the jagged edge of the logo's lombax.
// Decorative: the heading names the section.
interface Props {
  id: 'progress' | 'activity' | 'how' | 'fresh' | 'all';
  class?: string;
}
const { id, class: className = '' } = Astro.props;

const INK = '#0c0c12';
const GOLD = '#f5c040';
const GOLD_DARK = '#d6a020';
const GOLD_LIGHT = '#ffe08f';
const PANEL = '#2a2a38';
const PANEL_LIGHT = '#3d3d50';
const WHITE = '#efeff3';
const BLUE = '#6f7af5';

function burst(cx: number, cy: number, r: number, n: number, turn = 0): string {
  const pts: string[] = [];
  for (let i = 0; i < n * 2; i++) {
    const a = turn + (i * Math.PI) / n;
    const rr = i % 2 ? r * 0.8 : r * (0.94 + 0.06 * Math.sin(i * 2.3));
    pts.push(`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a)).toFixed(1)}`);
  }
  return `M${pts.join('L')}Z`;
}

const bursts = {
  progress: burst(58, 50, 40, 11, 0.2),
  activity: burst(60, 48, 40, 10, 0.4),
  how: burst(60, 50, 42, 12, 0.1),
  fresh: burst(60, 52, 40, 12, 0.08),
  all: burst(60, 50, 40, 12, 0.22),
};
const line = { stroke: INK, 'stroke-width': 2.5, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' } as const;
---

<svg viewBox="0 0 120 96" aria-hidden="true" class={`flex-none overflow-visible ${className}`}>
  <path d={bursts[id]} fill={GOLD} fill-opacity="0.1" stroke={GOLD_DARK} stroke-opacity="0.55" stroke-width="1.5" stroke-linejoin="round"></path>
  {
    id === 'progress' && (
      <>
        <path d="M78 30V10" {...line} />
        <path d="M78 10h18l-5 6 5 6H78z" fill={BLUE} {...line} />
        <rect x="26" y="60" width="16" height="20" rx="2" fill={GOLD_DARK} {...line} />
        <rect x="48" y="46" width="16" height="34" rx="2" fill={GOLD} {...line} />
        <rect x="70" y="30" width="16" height="50" rx="2" fill={GOLD_LIGHT} {...line} />
        <path d="M16 80H98" {...line} stroke-width="3" />
      </>
    )
  }
  {
    id === 'activity' && (
      <>
        <rect x="20" y="14" width="66" height="66" rx="6" fill={PANEL} {...line} />
        {[30, 46, 62].map((y, i) => (
          <>
            <circle cx="32" cy={y} r="4" fill={GOLD} {...line} stroke-width="2" />
            <path d={`M42 ${y}h${[32, 24, 28][i]}`} stroke={WHITE} stroke-width="3" stroke-linecap="round" />
          </>
        ))}
        <circle cx="88" cy="68" r="17" fill={BLUE} {...line} />
        <path d="M88 58v10l7 5" fill="none" stroke={WHITE} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
      </>
    )
  }
  {
    id === 'how' && (
      <>
        <circle cx="32" cy="52" r="22" fill={WHITE} {...line} />
        <path d="M32 30a22 22 0 0 1 22 22H44a12 12 0 0 0-12-12z" fill={GOLD_LIGHT} />
        <circle cx="32" cy="52" r="22" fill="none" {...line} />
        <circle cx="32" cy="52" r="7" fill={PANEL} {...line} />
        <path d="M58 46l6 6-6 6M66 46l6 6-6 6" fill="none" stroke={GOLD} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="78" y="28" width="34" height="46" rx="5" fill={PANEL} {...line} />
        <path d="M86 40h12M86 48h18M90 56h10M86 64h14" stroke={GOLD} stroke-width="3" stroke-linecap="round" />
      </>
    )
  }
  {
    id === 'fresh' && (
      <>
        <rect x="28" y="40" width="64" height="40" rx="4" fill={PANEL} {...line} />
        <rect x="22" y="30" width="76" height="14" rx="3" fill={PANEL_LIGHT} {...line} />
        <path d="M60 30v50" {...line} stroke={GOLD} stroke-width="8" />
        <path d="M60 30c-8-12-24-12-20-2s20 2 20 2c8-12 24-12 20-2s-20 2-20 2z" fill={GOLD} {...line} />
      </>
    )
  }
  {
    id === 'all' && (
      <>
        <rect x="18" y="14" width="30" height="24" rx="4" fill={PANEL} {...line} />
        <rect x="54" y="14" width="30" height="24" rx="4" fill={GOLD} {...line} />
        <rect x="18" y="44" width="30" height="24" rx="4" fill={GOLD_DARK} {...line} />
        <rect x="54" y="44" width="30" height="24" rx="4" fill={PANEL_LIGHT} {...line} />
        <path d="M90 70l14 14" fill="none" stroke={INK} stroke-width="13" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M90 70l14 14" fill="none" stroke={GOLD} stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="80" cy="60" r="16" fill={PANEL} {...line} stroke-width="3" />
        <circle cx="80" cy="60" r="10" fill="none" stroke={GOLD_LIGHT} stroke-width="3" />
        <path d="M74 56a7 7 0 0 1 5-4" fill="none" stroke={WHITE} stroke-width="2.5" stroke-linecap="round" />
      </>
    )
  }
</svg>
