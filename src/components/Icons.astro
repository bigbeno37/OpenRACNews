---
// Decorative marks, as openrac.dev draws them. Screen readers skip them: the link text names the target.
interface Props {
  name: 'github' | 'rss' | 'down';
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;
---

{
  name === 'github' && (
    <svg viewBox="0 0 16 16" aria-hidden="true" class={`flex-none fill-current ${className}`}>
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
    </svg>
  )
}
{
  name === 'rss' && (
    <svg viewBox="0 0 16 16" aria-hidden="true" class={`flex-none fill-current ${className}`}>
      <circle cx="3.2" cy="12.8" r="1.8" />
      <path d="M1.4 6.2v2.5a5.9 5.9 0 0 1 5.9 5.9h2.5a8.4 8.4 0 0 0-8.4-8.4zm0-4.8v2.5a10.7 10.7 0 0 1 10.7 10.7h2.5A13.2 13.2 0 0 0 1.4 1.4z" />
    </svg>
  )
}
{
  name === 'down' && (
    <svg viewBox="0 0 16 16" aria-hidden="true" class={`flex-none fill-none stroke-current stroke-2 ${className}`}>
      <path d="M8 2v11m-4-4 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
