---
// The site's main view: every project as it stood on one day.
import { formatDay } from '../lib/days.ts';
import { formatNumber } from '../lib/format.ts';
import { dayFacts, dayOn, projectOn } from '../lib/news.ts';
import { paragraphs } from '../lib/prose.ts';
import { tracking } from '../lib/tracking.ts';
import Hero from './Hero.astro';
import Prose from './Prose.astro';
import RepoEvents from './RepoEvents.astro';
import Section from './Section.astro';
import SectionArt from './SectionArt.astro';
import StatusCard from './StatusCard.astro';

interface Props {
  date: string;
}
const { date } = Astro.props;
const day = await dayOn(date);
const projects = await Promise.all(tracking.repos.map((repo) => projectOn(repo, date)));
const { overview, totals } = day;

const stats: [number, string][] = [
  [totals.commits, totals.commits === 1 ? 'commit landed' : 'commits landed'],
  [totals.merged, totals.merged === 1 ? 'pull request merged' : 'pull requests merged'],
  [totals.opened, totals.opened === 1 ? 'pull request opened' : 'pull requests opened'],
  [totals.contributors, totals.contributors === 1 ? 'contributor' : 'contributors'],
];
---

<Hero eyebrow={formatDay(date)} compact>
  <Fragment slot="title">{overview ? <Prose text={overview.headline} inline /> : dayFacts(day)}</Fragment>

  <div class:list={['mt-7 grid gap-8 sm:mt-9', overview && 'min-[800px]:grid-cols-[minmax(0,1fr)_220px] min-[800px]:gap-12 lg:grid-cols-[minmax(0,1fr)_242px] lg:gap-[68px]']}>
    {overview && (
      <section id="in-brief" aria-labelledby="in-brief-heading" class="min-w-0">
        <div class="mb-4 flex items-center gap-2.5">
          <SectionArt id="activity" class="h-10 w-[50px]" />
          <h2 id="in-brief-heading" class="font-audiowide text-[clamp(20px,3vw,22px)] leading-snug text-hi">The day in brief</h2>
        </div>
        <div class="grid gap-4 text-[15px] leading-[1.7] text-soft sm:text-base">
          {paragraphs(overview.summary).map((paragraph) => (
            <p><Prose text={paragraph} inline /></p>
          ))}
        </div>
      </section>
    )}

    <aside aria-labelledby="day-numbers-heading" class:list={[overview && 'border-t border-line pt-5 min-[800px]:border-l min-[800px]:border-t-0 min-[800px]:border-brand/35 min-[800px]:pl-6 min-[800px]:pt-0']}>
      <h2 id="day-numbers-heading" class="font-orbitron text-[10px] font-bold uppercase tracking-[.18em] text-brand">The day in numbers</h2>
      <dl class:list={['mt-4 grid grid-cols-2 gap-x-5 gap-y-6', overview ? 'min-[800px]:grid-cols-1 min-[800px]:gap-y-0' : 'max-w-[900px] min-[560px]:grid-cols-4']}>
        {
          stats.map(([value, label]) => (
            <div class:list={['flex flex-col gap-1', overview && 'min-[800px]:border-t min-[800px]:border-line min-[800px]:py-4 min-[800px]:first:border-0 min-[800px]:first:pt-0 min-[800px]:last:pb-0']}>
              <dt class="text-xs leading-snug text-dim sm:text-[13px]">{label}</dt>
              <dd class="-order-1 whitespace-nowrap font-orbitron text-[25px] font-bold leading-tight tabular-nums text-gold min-[800px]:text-[31px]">{formatNumber(value)}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</Hero>

<div class="mt-6 border-t border-line [&>section]:pt-8 sm:[&>section]:pt-9">
  <Section id="projects" art="progress" title="Every project" sub="As each one stood at the end of this UTC day. Percentages are matched code from the project's own report, the same figure openrac.dev shows. A fainter second bar is matched data.">
    <div class="grid gap-3 sm:gap-4 md:grid-cols-2">
      {projects.map((project) => <StatusCard project={project} />)}
    </div>
  </Section>
</div>

<RepoEvents repos={day.repos} tagged />
