---
// A project on the home page, built like the game cards on openrac.dev. The whole card is one link to
// the project's page, so the text inside it has no links of its own.
import { formatDayShort } from '../lib/days.ts';
import { formatNumber } from '../lib/format.ts';
import { projectUrl } from '../lib/links.ts';
import { branchFacts, RECENT_DAYS, type Project } from '../lib/news.ts';
import { cardStyle, themeFor } from '../lib/themes.ts';
import DayBar from './DayBar.astro';
import Prose from './Prose.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { repo, recent, activity, lastActive } = project;
const theme = themeFor(repo.name);
const latest = project.branches.flatMap(({ branch, days }) => (days[0] ? [{ branch, day: days[0] }] : []));
---

<a href={projectUrl(repo.name)} class:list={['group/card relative isolate block overflow-hidden rounded-2xl bg-ink no-underline transition-transform hover:-translate-y-[3px]', theme.wide && 'md:col-span-2']} style={cardStyle(repo.name)}>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/95 via-ink/85 to-ink/70"></div>

  <div class="grid gap-4 p-5 sm:p-6">
    <div class="flex items-end justify-between gap-4">
      <div class="min-w-0">
        <h3 class={`${theme.font} text-[clamp(20px,3vw,26px)] leading-tight text-hi`}>{repo.title}</h3>
        <p class="mt-1 text-[13px] text-dim">{repo.name}</p>
      </div>
      <div class="grid flex-none justify-items-end text-right">
        <b class={`${theme.font} whitespace-nowrap text-[clamp(20px,3vw,26px)] leading-tight tabular-nums text-(--tx)`}>{formatNumber(recent.commits)}</b>
        <p class="mt-1 whitespace-nowrap text-[13px] text-dim">{recent.commits === 1 ? 'commit' : 'commits'} in {RECENT_DAYS} days</p>
      </div>
    </div>

    <DayBar activity={activity} />

    {
      latest.length > 0 ? (
        <div class="grid gap-3">
          {latest.map(({ branch, day }) => (
            <div class="min-w-0">
              <p class="mb-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[13px] text-dim">
                <span>{formatDayShort(day.date)}</span>
                {repo.branches.length > 1 && <span class="rounded-full border border-white/15 px-2 py-0.5 text-[10px] uppercase tracking-[.15em]">{branch.name}</span>}
              </p>
              {day.report ? (
                <p class="font-orbitron text-[15px] font-bold leading-snug text-gold sm:text-[16px]">
                  <Prose text={day.report.headline} inline plain />
                </p>
              ) : (
                <p class="text-soft">{branchFacts(day.facts)}</p>
              )}
            </div>
          ))}
        </div>
      ) : (
        <p class="text-dim">Nothing on record for this project yet.</p>
      )
    }

    <p class="text-[13px] font-semibold text-(--tx)">Open {theme.tag}<span class="sr-only">{lastActive ? `, last active ${formatDayShort(lastActive)}` : ''}</span></p>
  </div>

  <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[inherit] border border-white/8 transition-colors duration-500 group-hover/card:border-white/20"></div>
</a>
